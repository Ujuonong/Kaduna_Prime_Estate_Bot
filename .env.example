# ==========================================================================
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit `.env` itself.
# ==========================================================================

# --------------------------------------------------------------------------
# Google Workspace
# --------------------------------------------------------------------------
# Spreadsheet ID: open the sheet in the browser and copy the segment between
# `/d/` and `/edit` in the URL.
# https://docs.google.com/spreadsheets/d/<THIS_VALUE>/edit
GOOGLE_SHEET_ID=

# Google Calendar ID. Use your email address for the primary calendar, or the
# long random id from Google Calendar -> Settings -> Integrate calendar.
# Also share this calendar with the service account / OAuth client you connect.
GOOGLE_CALENDAR_ID=

# --------------------------------------------------------------------------
# Google Drive (RAG ingestion workflow)
# --------------------------------------------------------------------------
# ID of the Drive folder the ingestion workflow watches for new documents.
# Open the folder in a browser and copy the segment between `/folders/` and `/view`
# in the URL:
# https://drive.google.com/drive/folders/<THIS_VALUE>
GOOGLE_DRIVE_FOLDER_ID=

# --------------------------------------------------------------------------
# Agent routing
# --------------------------------------------------------------------------
# Fallback inbox that receives lead notifications when a property has no
# assigned agent. Also used as the default calendar attendee.
AGENT_EMAIL=

# --------------------------------------------------------------------------
# Google OAuth service account (used when running with a service account
# instead of interactive OAuth). Create in Google Cloud Console -> IAM &
# Admin -> Service Accounts -> JSON key. Share the spreadsheet and calendar
# with the service account e-mail address.
# --------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=